{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gofmt-on-write.sh",
            "statusMessage": "Running gofmt..."
          }
        ]
      }
    ]
  }
}
