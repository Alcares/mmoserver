{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github__(create_or_update_file|push_files|delete_file|merge_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/go-test-before-commit.sh",
            "timeout": 300,
            "statusMessage": "Running go test before commit..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gofmt-on-write.sh",
            "statusMessage": "Running gofmt..."
          }
        ]
      }
    ]
  }
}
